{
  "name": "artistos-server",
  "version": "0.1.0",
  "private": true,
  "description": "ArtistOS REST API (Express)",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.18"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --experimental-test-module-mocks --test \"tests/**/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1088.0",
    "@supabase/supabase-js": "2.110.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "razorpay": "2.9.8",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0"
  }
}
