# ArtistOS API (Express) environment. Copy to .env for local development.
# Validated at boot by src/config/env.js: a missing/invalid value stops the server.

# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Session signing secret, min 32 chars.
# MUST be identical to JWT_SECRET in the Next.js app (Vercel): both sides sign and
# verify the same artist/admin tokens. A mismatch makes every API call return 401.
JWT_SECRET=

# Browser origins allowed to call the API with cookies, comma-separated.
# Production: https://www.artistos.in   Local default: http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000

# Parent domain for session cookies so the Next.js proxy can read them.
# Production: .artistos.in   Local: leave empty (host-only cookies).
COOKIE_DOMAIN=

# Admin panel password (required in production, no fallback).
ADMIN_PASSWORD=

# Bearer token for /api/cron/* (GitHub Actions). Min 32 chars. Required in production;
# when unset, cron endpoints refuse every call.
CRON_SECRET=

# Wall-clock timezone for bookings/reminders.
APP_TIMEZONE=Asia/Kolkata

# --- Supabase (required in production) ---
# The NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY names are accepted too.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (required in production) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket URL; without it, file URLs are returned as storage paths.
R2_PUBLIC_URL=

# --- Razorpay (required in production) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp Cloud API (optional: sends are skipped without a token) ---
WHATSAPP_ACCESS_TOKEN=
# Defaults: the production sender id, v20.0, en, and the template names below.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANG=
WHATSAPP_DAILY_AGENDA_TEMPLATE_NAME=
WHATSAPP_NO_BOOKINGS_TEMPLATE_NAME=

# --- Web push / VAPID (optional: push is skipped without keys) ---
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is accepted for the public key too.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@artistos.app

# --- Notification timing (defaults shown) ---
BOOKING_REMINDER_2H_MINUTES=120
BOOKING_REMINDER_10M_MINUTES=10
NOTIFICATION_MAX_ATTEMPTS=3

# --- Added as modules are ported (phase 3) ---
# Portfolio storage limits (STORAGE_*).
