# ArtistOS API (Express) environment. Copy to .env for local development.
# Validated at boot by src/config/env.js: a missing/invalid value stops the server.

# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Session signing secret, min 32 chars.
# MUST be identical to JWT_SECRET in the Next.js app (Vercel): both sides sign and
# verify the same artist/admin tokens. A mismatch makes every API call return 401.
JWT_SECRET=

# Browser origins allowed to call the API with cookies, comma-separated.
# Production: https://www.artistos.in   Local default: http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000

# Parent domain for session cookies so the Next.js proxy can read them.
# Production: .artistos.in   Local: leave empty (host-only cookies).
COOKIE_DOMAIN=

# Admin panel password (required in production, no fallback).
ADMIN_PASSWORD=

# Bearer token for /api/cron/* (GitHub Actions). Min 32 chars. Required in production;
# when unset, cron endpoints refuse every call.
CRON_SECRET=

# --- Added as integrations are ported (phase 2+) ---
# Supabase, Cloudflare R2, Razorpay, WhatsApp, web-push (VAPID), storage limits.
